#!/bin/bash

clear

green="\e[38;5;82m"
red="\e[38;5;196m"
yellow="\e[38;5;226m"
neutral="\e[0m"

API_DIR="/usr/bin/api-ari"
API_ZIP="/usr/bin/api-ari.zip"
API_PORT="5889"
SERVICE_FILE="/etc/systemd/system/apivpnlite.service"

cek_status() {
    systemctl is-active --quiet "$1" && echo -e "${green}GOOD${neutral}" || echo -e "${red}BAD${neutral}"
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || apt install -y "$2" >/dev/null 2>&1
}

setup_bot() {
    echo -e "${yellow}Installing API plugin...${neutral}"

    apt update -y >/dev/null 2>&1
    apt install -y curl unzip lsof dos2unix openssl nodejs npm >/dev/null 2>&1

    rm -rf "$API_DIR" "$API_ZIP"

    curl -L --connect-timeout 15 --max-time 120 \
        -o "$API_ZIP" \
        "https://raw.githubusercontent.com/xyzstore/new8/master/limit/api-ari.zip"

    if [ ! -s "$API_ZIP" ]; then
        echo -e "${red}Gagal download api-ari.zip${neutral}"
        exit 1
    fi

    cd /usr/bin || exit 1
    unzip -o "$API_ZIP" >/dev/null 2>&1
    rm -f "$API_ZIP"

    if [ ! -f "$API_DIR/api.js" ]; then
        echo -e "${red}Gagal install API: $API_DIR/api.js tidak ditemukan.${neutral}"
        exit 1
    fi

    chmod +x "$API_DIR"/*.sh 2>/dev/null
    dos2unix "$API_DIR"/*.sh "$API_DIR/api.js" 2>/dev/null

    if [ ! -d "$API_DIR/node_modules/express" ]; then
        npm install --prefix "$API_DIR" express >/dev/null 2>&1
    fi

    AUTH_KEY="$(grep '^export AUTH_KEY=' /etc/profile 2>/dev/null | tail -n1 | cut -d'"' -f2)"

    if [ -z "$AUTH_KEY" ]; then
        AUTH_KEY="$(openssl rand -hex 3)"
        sed -i '/export AUTH_KEY=/d' /etc/profile
        echo "export AUTH_KEY=\"$AUTH_KEY\"" >> /etc/profile
    fi

    echo -e "${green}Setup API selesai.${neutral}"
}

server_app() {
    echo -e "${yellow}Starting API service...${neutral}"

    systemctl stop apivpnlite.service >/dev/null 2>&1
    systemctl disable apivpnlite.service >/dev/null 2>&1
    rm -f "$SERVICE_FILE"
    systemctl daemon-reload >/dev/null 2>&1

    AUTH_KEY="$(grep '^export AUTH_KEY=' /etc/profile 2>/dev/null | tail -n1 | cut -d'"' -f2)"

    if [ -z "$AUTH_KEY" ]; then
        AUTH_KEY="$(openssl rand -hex 3)"
        sed -i '/export AUTH_KEY=/d' /etc/profile
        echo "export AUTH_KEY=\"$AUTH_KEY\"" >> /etc/profile
    fi

    if [ ! -f "$API_DIR/api.js" ]; then
        echo -e "${red}File $API_DIR/api.js tidak ditemukan.${neutral}"
        exit 1
    fi

    chmod +x "$API_DIR"/*.sh 2>/dev/null
    dos2unix "$API_DIR"/*.sh "$API_DIR/api.js" 2>/dev/null

    OLD_PID="$(lsof -ti:${API_PORT} 2>/dev/null)"
    if [ -n "$OLD_PID" ]; then
        kill -9 $OLD_PID 2>/dev/null
    fi

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=New8 VPN API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=${API_DIR}
Environment=AUTH_KEY=${AUTH_KEY}
ExecStart=/usr/bin/node ${API_DIR}/api.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable apivpnlite.service >/dev/null 2>&1
    systemctl restart apivpnlite.service >/dev/null 2>&1

    sleep 1

    echo -e "Status Server : $(cek_status apivpnlite.service)"
    echo -e "API Port      : ${API_PORT}"
    echo -e "AUTH_KEY      : ${AUTH_KEY}"
    echo -e ""
    echo -e "${green}Test lokal:${neutral}"
    echo -e "curl \"http://127.0.0.1:${API_PORT}/createssh?user=testapi&password=123456&exp=1&iplimit=1&auth=${AUTH_KEY}\""
    echo -e ""

    if command -v m-sellvpn >/dev/null 2>&1; then
        m-sellvpn
    elif [ -x /usr/local/sbin/m-sellvpn ]; then
        /usr/local/sbin/m-sellvpn
    fi
}

setup_bot
server_app
